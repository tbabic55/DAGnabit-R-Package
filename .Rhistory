layoutWidget(nodes, edges)
layoutWidget <- function(nodes = list(), edges = list(), enableFileInputs = FALSE, width = NULL, height = NULL) {
htmlwidgets::createWidget(
name = "layoutWidget",
x = list(
nodes = nodes,
edges = edges,
enableFileInputs = enableFileInputs
),
width = width,
height = height
)
}
nodes <- list(
list(id="Root", plate="Outer", x=220, y=160),
list(id="Inner", plate="Outer/Inner", x=380, y=160),
list(id="Deep", plate="Outer/Inner/Innermost", x=540, y=160),
list(id="Shared", plate="Outer/Inner;Shared", x=380, y=320),
list(id="Solo", plate="Shared", x=560, y=320)
)
edges <- list(
list(source="Root", target="Inner", type="deterministic"),
list(source="Inner", target="Deep", type="stochastic"),
list(source="Deep", target="Shared", type="deterministic"),
list(source="Inner", target="Solo", type="stochastic")
)
layoutWidget(nodes, edges, width="100%", height="600px")
